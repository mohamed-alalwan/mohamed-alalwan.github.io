---
import { site } from '../data/site';
const nav = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="brand-mark" aria-hidden="true">M<span class="brand-slash">/</span></span>
      <span class="brand-text">Mohamed<br />Alalwan</span>
    </a>
    <nav aria-label="Main navigation" class="main-nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="icon-link" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="Mohamed Alalwan on GitHub" title="GitHub"><svg aria-hidden="true" focusable="false" class="icon"><use href="#icon-github" /></svg></a>
      <a class="icon-link" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="Mohamed Alalwan on LinkedIn" title="LinkedIn"><svg aria-hidden="true" focusable="false" class="icon"><use href="#icon-linkedin" /></svg></a>
      <button class="icon-link theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme"><svg aria-hidden="true" focusable="false" class="icon moon-icon"><use href="#icon-moon" /></svg><svg aria-hidden="true" focusable="false" class="icon sun-icon"><use href="#icon-sun" /></svg></button>
      <a class="header-cv" href={site.cv} download="Mohamed_Alalwan_CV.pdf" aria-label="Download Mohamed Alalwan CV (PDF)"><svg aria-hidden="true" focusable="false" class="icon"><use href="#icon-download" /></svg><span>Download CV</span></a>
    </div>
  </div>
</header>
<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const updateThemeLabel = () => {
    if (!themeToggle) return;
    const isLight = document.documentElement.classList.contains('theme-light');
    themeToggle.setAttribute('aria-label', `Switch to ${isLight ? 'dark' : 'light'} theme`);
    themeToggle.setAttribute('title', `Switch to ${isLight ? 'dark' : 'light'} theme`);
    themeToggle.setAttribute('aria-pressed', String(!isLight));
  };
  updateThemeLabel();
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('theme-light');
    try { localStorage.setItem('portfolio-theme', document.documentElement.classList.contains('theme-light') ? 'light' : 'dark'); } catch {}
    updateThemeLabel();
  });
</script>
