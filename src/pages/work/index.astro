---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Case studies" description="A closer look at Mohamed Alalwan’s work at Penny Software, KPMG Bahrain and Bahrain Diabetes Society.">
  <section class="page-hero"><div class="shell"><span class="section-label">CASE STUDIES</span><h1>A closer look<br /><em>at the work.</em></h1><p>Five projects across product engineering, AI consulting, a personal prototype and volunteer work.</p></div></section>
  <section class="section"><div class="shell"><div class="work-grid all-work">{work.map((entry, index) => <WorkCard entry={entry} index={index + 1} />)}</div><div class="note-panel"><strong>Project details</strong><p>Client data and employer-owned code are omitted.</p><a class="text-link" href="/#projects">All projects <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
